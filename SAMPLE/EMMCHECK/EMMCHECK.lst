       155E                     RCVBYTE:
0002BE 155E CD9315          17          CALL    F1CHK      ;PORTC BIT7が1になるまでLOOP
0002C1 1561 DBA1            11          IN      A,(0A1H)   ;PORTB -> A
0002C3 1563 F5              11          PUSH    AF
0002C4 1564 3E05             7          LD      A,05H
0002C6 1566 D3A3            11          OUT     (0A3H),A    ;PORTC BIT2 <- 1
0002C8 1568 CD9A15          17          CALL    F2CHK      ;PORTC BIT7が0になるまでLOOP
0002CB 156B 3E04             7          LD      A,04H
0002CD 156D D3A3            11          OUT     (0A3H),A    ;PORTC BIT2 <- 0
0002CF 156F F1              10          POP     AF
0002D0 1570 C9              10          RET
                                        
                                ;**** 1BYTE送信 ****
                                ;Aレジスタの内容をPORTA下位4BITに4BITずつ送信
       1571                     SNDBYTE:
0002D1 1571 F5              11          PUSH    AF
0002D2 1572 1F               4          RRA
0002D3 1573 1F               4          RRA
0002D4 1574 1F               4          RRA
0002D5 1575 1F               4          RRA
0002D6 1576 E60F             7          AND     0FH
0002D8 1578 CD8215          17          CALL    SND4BIT
0002DB 157B F1              10          POP     AF
0002DC 157C E60F             7          AND     0FH
0002DE 157E CD8215          17          CALL    SND4BIT
0002E1 1581 C9              10          RET
                                
                                ;**** 4BIT送信 ****
                                ;Aレジスタ下位4ビットを送信する
       1582                     SND4BIT:
0002E2 1582 D3A0            11          OUT     (0A0H),A
0002E4 1584 3E05             7          LD      A,05H
0002E6 1586 D3A3            11          OUT     (0A3H),A    ;PORTC BIT2 <- 1
0002E8 1588 CD9315          17          CALL    F1CHK      ;PORTC BIT7が1になるまでLOOP
0002EB 158B 3E04             7          LD      A,04H
0002ED 158D D3A3            11          OUT     (0A3H),A    ;PORTC BIT2 <- 0
0002EF 158F CD9A15          17          CALL    F2CHK
0002F2 1592 C9              10          RET
                                        
                                ;**** BUSYをCHECK(1) ****
                                ; 82H BIT7が1になるまでLOP
0002F3 1593 DBA2            11  F1CHK:  IN      A,(0A2H)
0002F5 1595 E680             7          AND     80H        ;PORTC BIT7 = 1?
0002F7 1597 28FA            12          JR      Z,F1CHK
0002F9 1599 C9              10          RET
                                
                                ;**** BUSYをCHECK(0) ****
                                ; 82H BIT7が0になるまでLOOP
0002FA 159A DBA2            11  F2CHK:  IN      A,(0A2H)
0002FC 159C E680             7          AND     80H        ;PORTC BIT7 = 0?
0002FE 159E 20FA            12          JR      NZ,F2CHK
000300 15A0 C9              10          RET
                                
